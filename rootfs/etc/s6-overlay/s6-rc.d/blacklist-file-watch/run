#!/command/with-contenv bash

set -eu

sleep_forever() {
  while true; do
    sleep 3600
  done
}

if [ -n "${BLACKLIST_URL:-}" ]; then
  sleep_forever
fi

BLACKLIST_FILE="${BLACKLIST_FILE:-/etc/unbound/blacklist.txt}"
if [ ! -e "$BLACKLIST_FILE" ]; then
  sleep_forever
fi

if ! command -v inotifywait >/dev/null 2>&1; then
  sleep_forever
fi

watch_dir="$(dirname "$BLACKLIST_FILE")"
watch_file="$(basename "$BLACKLIST_FILE")"

while true; do
  inotifywait -q -e close_write -e moved_to -e create -e delete --format '%f' "$watch_dir" \
    | while read -r name; do
        if [ "$name" = "$watch_file" ]; then
          /usr/local/bin/blacklist-sync.sh || true
        fi
      done
done
