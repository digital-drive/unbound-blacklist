#!/command/with-contenv bash

set -eu

sleep_forever() {
  while true; do
    sleep 3600
  done
}

refresh_seconds="${BLACKLIST_REFRESH_SECONDS:-600}"
case "$refresh_seconds" in
  ''|*[!0-9]*)
    refresh_seconds=600
    ;;
esac

initial_seconds="${BLACKLIST_REFRESH_INITIAL_SECONDS:-$refresh_seconds}"
case "$initial_seconds" in
  ''|*[!0-9]*)
    initial_seconds="$refresh_seconds"
    ;;
esac

if [ -z "${BLACKLIST_URL:-}" ] || [ "$refresh_seconds" -le 0 ]; then
  sleep_forever
fi

# cont-init already synced once. Retry right away only if it found no source
# (URL unreachable and no cache), otherwise wait for the initial delay first.
if [ ! -f /run/blacklist-first-sync.done ]; then
  /usr/local/bin/blacklist-sync.sh || true
fi

sleep "$initial_seconds"
while true; do
  /usr/local/bin/blacklist-sync.sh || true
  sleep "$refresh_seconds"
done
